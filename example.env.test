# Configurações de variaveis de ambiente para testes
# Renomeie este arquivo para .env.test e preencha os campos abaixo com as informações necessarios

# Porta do servidor, como 3000 por exemplo
PORT= 

# Chave da API do Google
GOOGLE_API_KEY= 

# caracteristicas do produto, como comprimento, largura e altura. Pode deixar os valores que estão aí que funcionanm
#Usado na api dos correios
PRODUCT_COMPRIMENTO= '20'
PRODUCT_LARGURA= '15'
PRODUCT_ALTURA= '10'
